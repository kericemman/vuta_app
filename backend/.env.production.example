NODE_ENV=production
PORT=5050
MONGODB_URI=<your-production-mongodb-atlas-uri>
MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Public website/admin origins allowed to call the API.
CLIENT_URL=https://vuta.app,https://www.vuta.app
FRONTEND_URL=https://vuta.app

# Rate limits
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=25
SENSITIVE_WRITE_RATE_LIMIT_MAX=120

# Email
RESEND_API_KEY=<your-resend-api-key>
RESEND_FROM_EMAIL=Vuta <noreply@vuta.app>
ADMIN_EMAIL=<your-admin-email>
SECURITY_ALERT_EMAIL=<your-security-alert-email>
SECURITY_ALERT_COOLDOWN_MS=300000
WAITLIST_ADMIN_KEY=<generate-a-long-random-key>

# Auth
JWT_ACCESS_SECRET=<generate-64-plus-random-characters>
JWT_REFRESH_SECRET=<generate-another-64-plus-random-characters>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>
CLOUDINARY_PORTFOLIO_FOLDER=vuta/portfolio
CLOUDINARY_PROFILE_FOLDER=vuta/profile
CLOUDINARY_SERVICE_FOLDER=vuta/services
CLOUDINARY_EMPLOYEE_FOLDER=vuta/business-employees
CLOUDINARY_AD_CARDS_FOLDER=vuta/ad-cards
CLOUDINARY_APP_UPDATES_FOLDER=vuta/app-updates

# Admin seed. Use once, then keep values in your secret manager.
ADMIN_USER_NAME=Vuta Admin
ADMIN_USER_EMAIL=<your-admin-email>
ADMIN_USER_PHONE=<your-admin-phone>
ADMIN_USER_PASSWORD=<generate-a-strong-password>

# Security/fallback controls
# normal | read_only | maintenance | force_update | incident_lockdown
APP_SECURITY_MODE=normal
APP_SECURITY_MESSAGE=
APP_DISABLED_FEATURES=
APP_INCIDENT_ID=
APP_MIN_MOBILE_BUILD=
APP_STATUS_URL=https://vuta.app/status
